___SANDBOXED_JS_FOR_SERVER___

const sendHttpRequest = require('sendHttpRequest');
const getEventData = require('getEventData');
const templateDataStorage = require('templateDataStorage');
const getTimestampMillis = require('getTimestampMillis');
const sha256Sync = require('sha256Sync');
const makeString = require('makeString');
const makeInteger = require('makeInteger');
const JSON = require('JSON');

function storeKey() {
  const byUser = data.keySource === 'user_id';
  const id = getEventData(byUser ? 'user_id' : 'client_id');
  if (id === undefined || id === null || id === '') {
    return undefined;
  }
  // the id never travels or is stored as it is: only its hash
  return (byUser ? 'uid:' : 'cid:') + sha256Sync(makeString(id), {outputEncoding: 'hex'});
}

function pick(profile) {
  if (!profile) {
    return undefined;
  }
  const v = profile[data.field];
  return v === '' ? undefined : v;
}

function remember(key, profile) {
  let n = templateDataStorage.getItemCopy('ot_count') || 0;
  if (n > 2000) {
    templateDataStorage.clear();
    n = 0;
  }
  templateDataStorage.setItemCopy('ot_count', n + 1);
  templateDataStorage.setItemCopy(key, {at: getTimestampMillis(), profile: profile});
}

// 1. the event's own value always wins
if (data.eventDataKey) {
  const own = getEventData(data.eventDataKey);
  if (own) {
    return own;
  }
}

const key = storeKey();
if (!key) {
  return undefined;
}

// 2. one call answers every field of the same visitor for a few seconds
const keepMs = (makeInteger(data.cacheSeconds) || 30) * 1000;
const hit = templateDataStorage.getItemCopy('ot_' + key);
if (hit && getTimestampMillis() - hit.at < keepMs) {
  return pick(hit.profile);
}

// 3. ask the Data Store
return sendHttpRequest(data.apiUrl + '/entries/' + key, {
  method: 'GET',
  headers: {'Authorization': 'Bearer ' + data.token},
  timeout: 2000
}).then(function(response) {
  let profile = null;
  if (response.statusCode === 200) {
    const parsed = JSON.parse(response.body);
    profile = parsed && parsed.value ? parsed.value : null;
  }
  remember('ot_' + key, profile);
  return pick(profile);
}).catch(function() {
  return undefined;
});


